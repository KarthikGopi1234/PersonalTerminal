    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group android:scaleX="0.82" android:scaleY="0.82" android:pivotX="256" android:pivotY="256">
        <!-- ring -->
        <path
            android:pathData="M256,106 a150,150 0 1,0 0.01,0 z"
            android:strokeColor="#6272A4"
            android:strokeWidth="10"
            android:strokeAlpha="0.7"
            android:fillColor="#00000000" />
        <!-- indices -->
        <path android:pathData="M256,94 L256,120" android:strokeColor="#6272A4" android:strokeWidth="10" android:strokeLineCap="round" android:strokeAlpha="0.8" />
        <path android:pathData="M418,256 L392,256" android:strokeColor="#6272A4" android:strokeWidth="10" android:strokeLineCap="round" android:strokeAlpha="0.8" />
        <path android:pathData="M256,418 L256,392" android:strokeColor="#6272A4" android:strokeWidth="10" android:strokeLineCap="round" android:strokeAlpha="0.8" />
        <path android:pathData="M94,256 L120,256" android:strokeColor="#6272A4" android:strokeWidth="10" android:strokeLineCap="round" android:strokeAlpha="0.8" />
        <!-- prompt chevron / check -->
        <path
            android:pathData="M176,172 L268,256 L176,340"
            android:strokeColor="#50FA7B"
            android:strokeWidth="40"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <!-- block cursor / crown -->
        <path
            android:pathData="M308,228 h44 a8,8 0 0 1 8,8 v40 a8,8 0 0 1 -8,8 h-44 a8,8 0 0 1 -8,-8 v-40 a8,8 0 0 1 8,-8 z"
